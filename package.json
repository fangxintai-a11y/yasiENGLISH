{
  "name": "band-galaxy",
  "version": "1.0.0",
  "type": "module",
  "description": "雅思星图 Band Galaxy: an IELTS vocabulary app built on Word Atlas — three memory tracks per word, an exam-date plan, objective grading and exam-day recall forecasts.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "python3 server/app.py --db .sync-data/progress.sqlite3",
    "test:server": "python3 -m unittest discover -s server -p 'test_*.py'",
    "test:sync": "node scripts/test-sync-e2e.mjs",
    "test:learning": "node scripts/test-learning-e2e.mjs",
    "check:curriculum": "node --import tsx scripts/curriculum/validate-content.mjs",
    "prebuild": "node scripts/build-offline-pack.mjs",
    "build": "tsc -b && vite build",
    "build:pack": "node scripts/build-offline-pack.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/**/*.test.ts src/ielts/scoring/*.test.ts src/ielts/scoring/rules/*.test.ts src/ielts/llm/*.test.ts scripts/curriculum/*.test.mjs scripts/guard/*.test.mjs",
    "check:atlas": "node scripts/check-atlas.mjs",
    "build:atlas": "python3 scripts/atlas/build_atlas.py",
    "build:ielts": "python3 -I scripts/ielts/build_ielts.py",
    "build:syl": "python3 -I scripts/ielts/build_syllables.py",
    "build:confusables": "python3 -I scripts/ielts/build_confusables.py",
    "render:cards": "node scripts/render-cards.mjs",
    "pack:public": "python3 scripts/package_public.py --out ../开源发布/word-atlas",
    "format": "prettier --write src vite.config.ts scripts/*.mjs package.json tsconfig.json",
    "check:vendor-text": "node scripts/guard/vendor-text.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "private": true,
  "license": "MIT"
}
