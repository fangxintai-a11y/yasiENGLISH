with tempfile.TemporaryDirectory(prefix='band-candidate-') as scratch:
    server = module.create_server('127.0.0.1', 0, pathlib.Path(scratch) / 'check.sqlite3', public_origin='http://localhost:5188', secure_cookie=False, single_user=False)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        base = 'http://127.0.0.1:' + str(server.server_address[1])
        with urllib.request.urlopen(base + '/api/health', timeout=10) as response:
            assert json.load(response) == {'ok': True}
        with urllib.request.urlopen(base + '/api/auth/session', timeout=10) as response:
            assert json.load(response) == {'user': None}
        with urllib.request.urlopen(base + '/api/capabilities', timeout=10) as response:
            version = json.load(response)['learningRecords']
            assert type(version) is int and version >= 2
        try:
            urllib.request.urlopen(base + f'/api/learning/v{version}/changes', timeout=10)
        except urllib.error.HTTPError as error:
            assert error.code == 401
        else:
            raise AssertionError('Learning records must require authentication')
        database = pathlib.Path(scratch) / 'check.sqlite3'
