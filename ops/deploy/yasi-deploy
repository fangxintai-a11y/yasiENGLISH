#!/usr/bin/env bash
# Receive a checked local artifact. This tool never changes shared web-server config.
set -Eeuo pipefail
umask 022
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
unset ATLAS_BASE
[[ $EUID -eq 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
first_install=${BAND_DEPLOY_FIRST_INSTALL:-0}
single_user=${BAND_DEPLOY_SINGLE_USER:-0}
[[ $first_install == 0 || $first_install == 1 ]] || exit 2
[[ $single_user == 0 || $single_user == 1 ]] || exit 2
prebuilt=0
if [[ ${1:-} == --prebuilt ]]; then prebuilt=1; shift; fi
[[ $# -eq 4 ]] || { echo 'Usage: yasi-deploy [--prebuilt] ARCHIVE SHA256 COMMIT RELEASE_ID' >&2; exit 2; }
archive=$1; digest=$2; revision=$3; release_id=$4
root=${BAND_DEPLOY_ROOT:?Set BAND_DEPLOY_ROOT}
web_root=${BAND_DEPLOY_WEB_ROOT:?Set BAND_DEPLOY_WEB_ROOT}
host=${BAND_DEPLOY_HOST:?Set BAND_DEPLOY_HOST}
https_port=${BAND_DEPLOY_HTTPS_PORT:-8443}
api_port=${BAND_DEPLOY_API_PORT:-5189}
api_service=${BAND_DEPLOY_API_SERVICE:-band-galaxy.service}
minimum_mb=${BAND_DEPLOY_MIN_FREE_MB:-1024}
lock=${BAND_DEPLOY_LOCK:-$root/deploy.lock}
env_file=${BAND_DEPLOY_ENV_FILE:-$root/server.env}
database=${BAND_DEPLOY_DB:?Set BAND_DEPLOY_DB}
backup_dir=${BAND_DEPLOY_BACKUP_DIR:-$(dirname "$database")/backups}
backup_script=${BAND_DEPLOY_BACKUP_SCRIPT:?Set BAND_DEPLOY_BACKUP_SCRIPT}
[[ $root == /* && $root != / && $web_root == /* && $web_root != / && $lock == /* && $database == /* && $backup_dir == /* && $backup_script == /* && $env_file == /* ]] || { echo 'Deployment paths must be absolute and roots must not be /.' >&2; exit 2; }
api_user=''
run_db() {
    if [[ $single_user == 1 ]]; then
        [[ -n $api_user ]] || { echo 'API service user must be verified before database access.' >&2; return 1; }
        runuser -u "$api_user" -- "$@"
    else
        "$@"
    fi
}
resolve_api_user() {
    [[ $single_user == 1 ]] || return 0
    api_user=$(systemctl show --property=User --value "$api_service")
    expected_api_user=${BAND_DEPLOY_API_USER:-fangxintai}
    [[ $api_user =~ ^[a-z_][a-z0-9_-]*$ && $api_user != root && $api_user == "$expected_api_user" ]] || { echo 'Configured API User must match the expected non-root service account.' >&2; return 1; }
    printf 'Single-owner database writer: %s\n' "$api_user"
    runuser -u "$api_user" -- test -w "$(dirname "$database")"
    if [[ -e $database ]]; then
        runuser -u "$api_user" -- test -r "$database"
        runuser -u "$api_user" -- test -w "$database"
    fi
}
root=${root%/}; web_root=${web_root%/}
[[ $host =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ && $https_port =~ ^[0-9]+$ && $api_port =~ ^[0-9]+$ && $minimum_mb =~ ^[0-9]+$ ]] || { echo 'Invalid deployment configuration.' >&2; exit 2; }
(( https_port >= 1024 && https_port <= 65535 && api_port >= 1024 && api_port <= 65535 && minimum_mb > 0 )) || { echo 'Only dedicated ports >=1024 are allowed.' >&2; exit 2; }
[[ $api_service =~ ^[A-Za-z0-9_.@:-]+\.service$ && $api_service != *nginx* ]] || { echo 'Pass the dedicated API service name.' >&2; exit 2; }
[[ $digest =~ ^[0-9a-f]{64}$ && $revision =~ ^[0-9a-f]{40}$ ]] || { echo 'Invalid archive digest or revision.' >&2; exit 2; }
[[ $release_id =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$ && $release_id == *-${revision:0:8} ]] || { echo 'Invalid release ID.' >&2; exit 2; }
[[ -d $root && -d $web_root && $archive == "$root/incoming/$release_id.tar.gz" && -f $archive && ! -L $archive ]] || { echo 'Invalid configured upload path.' >&2; exit 2; }
install -d -m 755 "$(dirname "$lock")"
exec 9>"$lock"
flock -n 9 || { echo 'Another deployment is running.' >&2; exit 1; }
current="$web_root/current"
previous=''
if [[ -L $current ]]; then
    previous=$(readlink -f "$current")
    [[ -d $previous && $previous == "$root/releases/${previous##*/}" && ${previous##*/} =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$ ]] || { echo 'Current release must be a managed symlink.' >&2; exit 1; }
else
    [[ $first_install == 1 && ! -e $current ]] || { echo 'Current release must be a managed symlink; empty installations require BAND_DEPLOY_FIRST_INSTALL=1.' >&2; exit 1; }
fi
temporary_link="$web_root/.current.$$.new"
release="$root/releases/$release_id"
build="$root/builds/$release_id"
api_current="$root/api-current"
api_previous=''
api_release="$root/api-releases/$release_id"
api_link="$root/.api.$$.new"
api_was_active=0
if [[ -L $api_current ]]; then
    api_previous=$(readlink -f "$api_current")
    [[ $api_previous == "$root/api-releases/${api_previous##*/}" && ${api_previous##*/} =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$ && -f $api_previous/app.py ]] || { echo 'Current API link is invalid.' >&2; exit 1; }
    if systemctl is-active --quiet "$api_service"; then api_was_active=1; fi
else
    [[ ! -e $api_current ]] || { echo 'Current API path must be a managed symlink.' >&2; exit 1; }
fi
switched=0; api_switched=0; owned_stage=0
rollback_on_failure() {
    status=${1:-$?}
    trap - ERR INT TERM
    [[ ! -L $temporary_link ]] || unlink "$temporary_link"
    if (( switched )); then
        echo 'Deployment failed; restoring previous code links. Database is retained.' >&2
        if [[ -n $previous ]]; then
            ln -s "$previous" "$temporary_link"
            mv -Tf "$temporary_link" "$current"
        else
            [[ ! -L $current ]] || unlink "$current"
        fi
    fi
    [[ ! -L $api_link ]] || unlink "$api_link"
    if (( api_switched )); then
        if [[ -n $api_previous ]]; then
            ln -s "$api_previous" "$api_link"
            mv -Tf "$api_link" "$api_current"
        else
            [[ ! -L $api_current ]] || unlink "$api_current"
        fi
        if (( api_was_active )) && run_db python3 "$backup_script" --db "$database" --verify-api "$api_previous"; then
            systemctl restart "$api_service" || true
        else
            echo 'Previous API is not verified for the current database; its writes remain stopped. Database was not restored.' >&2
            systemctl stop "$api_service" || true
        fi
    fi
    [[ ! -L $temporary_link ]] || unlink "$temporary_link"
    [[ ! -L $api_link ]] || unlink "$api_link"
    if (( owned_stage )); then
        # Only paths created by this attempt are removed; retain the upload for retry.
        [[ $(readlink -f "$current") == "$release" ]] || rm -rf --one-file-system -- "$release"
        [[ $(readlink -f "$api_current") == "$api_release" ]] || rm -rf --one-file-system -- "$api_release"
        rm -rf --one-file-system -- "$build"
    fi
    exit "$status"
}
trap rollback_on_failure ERR
trap 'rollback_on_failure 130' INT
trap 'rollback_on_failure 143' TERM
available_kib=$(df --output=avail -k "$root" | tail -1)
if [[ ! $available_kib =~ ^[[:space:]]*[0-9]+[[:space:]]*$ ]] || (( available_kib < minimum_mb * 1024 )); then
    echo "Need at least $minimum_mb MB available for this artifact." >&2
    rollback_on_failure 1
fi
[[ ! -e $release && ! -e $build && ! -e $api_release && ! -L $temporary_link && ! -L $api_link ]] || { echo 'Release or staging path already exists.' >&2; rollback_on_failure 1; }
printf '%s  %s\n' "$digest" "$archive" | sha256sum -c -
install -d -m 755 "$root/builds" "$root/deployments" "$root/releases" "$root/api-releases"
mkdir -p "$build/source"
owned_stage=1
