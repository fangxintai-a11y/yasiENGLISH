    raise ValueError('Shared atlas must not also be included in the application artifact')
for name in ['index.json', 'img', 'audio']:
    if not (root / name).exists():
        raise ValueError('Shared atlas is incomplete: ' + name)
pathlib.Path('dist/atlas').symlink_to(root, target_is_directory=True)
paths = manifest.get('sharedPaths', [])
