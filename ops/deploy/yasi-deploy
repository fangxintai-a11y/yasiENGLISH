    if not target.is_relative_to(root.resolve()) or not target.exists() or link.exists() or link.is_symlink():
        raise ValueError('Missing or conflicting shared media path: ' + destination)
    link.parent.mkdir(parents=True, exist_ok=True)
    link.symlink_to(target, target_is_directory=target.is_dir())
