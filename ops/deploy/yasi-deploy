import hashlib, importlib.util, json, pathlib, sqlite3, sys, tempfile, threading, urllib.request, urllib.error
from contextlib import closing
artifact = pathlib.Path(sys.argv[1])
spec = importlib.util.spec_from_file_location('band_candidate', artifact / 'app.py')
