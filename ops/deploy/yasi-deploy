        raise ValueError('Invalid shared media entry')
    destination, shared = entry['path'], entry['sharedPath']
    def safe(value):
        return isinstance(value, str) and value and not value.startswith('/') and '\\' not in value and all(part not in ('', '.', '..') for part in value.split('/'))
    if not safe(destination) or not safe(shared) or not shared.startswith('_public/') or destination.split('/')[0] in ('atlas', 'api', 'private', 'server'):
