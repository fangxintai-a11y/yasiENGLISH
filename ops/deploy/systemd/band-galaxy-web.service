[Unit]
Description=Band Galaxy dedicated HTTPS website
After=network-online.target band-galaxy.service
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
ExecStart=/usr/bin/caddy run --environ --config /etc/caddy/band-galaxy.Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/band-galaxy.Caddyfile --adapter caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
Restart=on-failure

[Install]
WantedBy=multi-user.target
