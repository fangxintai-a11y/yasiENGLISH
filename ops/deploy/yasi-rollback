#!/usr/bin/env bash
set -Eeuo pipefail
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[[ $EUID -eq 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
exec 9>/run/lock/yasi-deploy.lock
flock -n 9 || { echo 'Another deployment is running.' >&2; exit 1; }
target=${1:-}
[[ $target =~ ^/opt/yasi/releases/[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$ && -f $target/index.html ]] || { echo 'Pass a valid release path. Available releases:' >&2; find /opt/yasi/releases -mindepth 1 -maxdepth 1 -type d; exit 1; }
current=/var/www/yasi/current
previous=$(readlink -f "$current")
temp_link="/var/www/yasi/.rollback.$$.new"
api_current=/opt/yasi/api-current
api_previous=''
api_target="/opt/yasi/api-releases/${target##*/}"
api_link="/opt/yasi/.api-rollback.$$.new"
api_was_active=0
api_switched=0
if [[ -L $api_current ]]; then
    api_previous=$(readlink -f "$api_current")
    [[ $api_previous =~ ^/opt/yasi/api-releases/[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$ && -f $api_previous/app.py ]] || { echo 'Current API link is invalid.' >&2; exit 1; }
    if systemctl is-active --quiet band-galaxy.service; then api_was_active=1; fi
else
    [[ ! -e $api_current ]] || { echo 'Current API path must be a managed symlink.' >&2; exit 1; }
fi
[[ ! -L $api_link && ! -L $temp_link ]] || { echo 'A temporary rollback link already exists.' >&2; exit 1; }
restore() {
    status=${1:-$?}
    trap - ERR INT TERM
    [[ ! -L $temp_link ]] || unlink "$temp_link"
    ln -s "$previous" "$temp_link"
    mv -Tf "$temp_link" "$current"
    if (( api_switched )); then
        [[ ! -L $api_link ]] || unlink "$api_link"
        if [[ -n $api_previous ]]; then
            ln -s "$api_previous" "$api_link"
            mv -Tf "$api_link" "$api_current"
        else
            [[ ! -L $api_current ]] || unlink "$api_current"
        fi
        if (( api_was_active )); then systemctl restart band-galaxy.service || true
        else systemctl stop band-galaxy.service || true; fi
    fi
    systemctl reload nginx || true
    exit "$status"
}
nginx -t
trap restore ERR
trap 'restore 130' INT
trap 'restore 143' TERM
# Roll back code only. Never replace or delete the persistent database.
if [[ -f $api_target/app.py && ! -L $api_target ]]; then
    [[ -r /etc/band-galaxy.env ]] || { echo 'Sync service configuration is missing.' >&2; restore 1; }
    ln -s "$api_target" "$api_link"
    api_switched=1
    mv -Tf "$api_link" "$api_current"
    systemctl restart band-galaxy.service
    curl --fail --silent --show-error --retry 5 --retry-connrefused --retry-delay 1 --max-time 10 http://127.0.0.1:5189/api/health -o /dev/null
elif [[ -n $api_previous ]]; then
    api_switched=1
    unlink "$api_current"
    systemctl stop band-galaxy.service
fi
ln -s "$target" "$temp_link"
mv -Tf "$temp_link" "$current"
systemctl reload nginx
curl --fail --silent --show-error --retry 5 --retry-connrefused --retry-delay 1 --max-time 30 --resolve www.i2023.com:443:127.0.0.1 https://www.i2023.com/ -o /dev/null
if [[ -f $api_target/app.py ]]; then
    curl --fail --silent --show-error --retry 3 --retry-connrefused --retry-delay 1 --max-time 10 --resolve www.i2023.com:443:127.0.0.1 https://www.i2023.com/api/health -o /dev/null
fi
trap - ERR INT TERM
printf 'Live release: %s\n' "$target"
