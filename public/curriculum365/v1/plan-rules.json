      "consecutive": 1,
      "targets": {
        "overall": 7,
        "listening": 7.5,
        "reading": 7.5,
        "writing": 6.5,
        "speaking": 6.5
      },
      "writingSpeakingSources": [
        "human",
        "official"
      ],
      "onMiss": "按四科差距补强，写说用同稿真人评分对照自评/机器估分，优先修复反复错因。"
    },
    {
      "id": "G3",
      "atMonth": 10,
      "consecutive": 2,
      "targets": {
        "overall": 7.5,
        "listening": 8,
        "reading": 8,
        "writing": 7,
        "speaking": 7
      },
      "writingSpeakingSources": [
        "human",
        "official"
      ],
      "onMiss": "保留连续两次不同未见材料的实际分；未连过则继续分科纠错与真人反馈，不把不连续最好成绩拼接。"
    },
    {
      "id": "G4",
      "atMonth": "exam",
      "consecutive": 1,
      "targets": {
        "overall": 8,
        "listening": 8.5,
        "reading": 8.5,
        "writing": 7.5,
        "speaking": 7.5
      },
      "writingSpeakingSources": [
        "official"
      ],
      "onMiss": "保留正式成绩和各科差距，目标保持不变；重新安排补强与下一次考试，不用AI、自评或日期宣布完成。"
    }
  ],
  "weeklyCalibration": {
    "weeks": 52,
    "day": "sunday",
    "items": [
      "task2-essay",
      "speaking-recording"
    ],
    "source": "human",
    "deviationAlert": 0.5,
    "comparison": "same-work-revision-and-rubric",
    "compareSources": [
      "self",
      "ai",
      "rules"
    ],
    "onDeviation": "同一作品任一评分项偏差达到0.5即提醒，保留三类分数并回看真人修改依据。",
    "backupRecordingsAfterCalibration": true
  },
