      "sections": {"listening": 8, "reading": 8, "writing": 7, "speaking": 7},
      "expected": {"overall": 7.5, "sectionFloorMet": true, "numericTargetMet": false, "finalGoalMet": false}
    },
    {
      "id": "all-sections-eight",
      "source": "official",
      "sections": {"listening": 8, "reading": 8, "writing": 8, "speaking": 8},
      "expected": {"overall": 8, "sectionFloorMet": true, "numericTargetMet": true, "finalGoalMet": true}
    },
    {
      "id": "recommended-combination",
      "source": "official",
      "sections": {"listening": 8.5, "reading": 8.5, "writing": 7.5, "speaking": 7.5},
      "expected": {"overall": 8, "sectionFloorMet": true, "numericTargetMet": true, "finalGoalMet": true}
    },
    {
      "id": "missing-writing-remains-unknown",
      "source": "human",
      "sections": {"listening": 8, "reading": 8, "writing": null, "speaking": 8},
      "expected": {"overall": null, "sectionFloorMet": false, "numericTargetMet": false, "finalGoalMet": false}
    },
    {
      "id": "ai-estimate-is-not-final-completion",
      "source": "ai",
      "sections": {"listening": 8, "reading": 8, "writing": 8, "speaking": 8},
      "expected": {"overall": 8, "sectionFloorMet": true, "numericTargetMet": true, "finalGoalMet": false}
    }
  ],
  "sources": [
